# Variables del stack de docker-compose.prod.yml (el API tiene el suyo en apps/api).
# Copiar a .env y completar antes de docker compose -f docker-compose.prod.yml up
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=
POSTGRES_DB=fittrack
JWT_SECRET=
JWT_EXPIRES_IN=7d
WEB_PORT=8080

# De qué mercado de OpenFoodFacts salen los alimentos que no están en el
# catálogo curado. El subdominio de país sesga la búsqueda: con world.* buscar
# "Alpina" devuelve una marca francesa de pasta, con co.* devuelve la Alpina
# colombiana. Los códigos de barras son globales y funcionan desde cualquiera.
OFF_API_URL=https://co.openfoodfacts.org

# Mail para el reset de contraseña. console imprime el link en el log y no
# necesita nada más (desarrollo). Con resend, RESEND_API_KEY es obligatoria.
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=FitTrack <no-reply@fittrack.app>
# Base del link de recuperación. En producción, la URL real de la app.
APP_URL=http://localhost:5177
