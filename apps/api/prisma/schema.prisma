generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Espeja el DDL de §4 del blueprint. Los CHECK de gender/unit_preference se
// modelan como enums nativos de Postgres (equivalente y tipado en el cliente).
enum Gender {
  male
  female
  other
}

enum UnitPreference {
  metric
  imperial
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @unique @db.VarChar(255)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  firstName      String         @map("first_name") @db.VarChar(100)
  dob            DateTime       @db.Date
  gender         Gender
  heightCm       Decimal        @map("height_cm") @db.Decimal(5, 2)
  activityLevel  Decimal        @default(1.200) @map("activity_level") @db.Decimal(4, 3)
  unitPreference UnitPreference @default(metric) @map("unit_preference")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  goals         UserGoal[]
  createdFoods  FoodItem[]
  dailyLogs     DailyLog[]
  weights       WeightEntry[]

  @@map("users")
}

model UserGoal {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  targetWeightKg Decimal  @map("target_weight_kg") @db.Decimal(5, 2)
  weeklyChangeKg Decimal  @map("weekly_change_kg") @db.Decimal(3, 2)
  dailyCalories  Int      @map("daily_calories")
  proteinGrams   Int      @map("protein_grams")
  carbsGrams     Int      @map("carbs_grams")
  fatGrams       Int      @map("fat_grams")
  effectiveFrom  DateTime @default(now()) @map("effective_from") @db.Date
  isActive       Boolean  @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_goals")
}

model FoodItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barcode           String?  @unique @db.VarChar(50)
  name              String   @db.VarChar(255)
  brand             String?  @db.VarChar(255)
  verified          Boolean  @default(false)
  servingSizeAmount Decimal  @map("serving_size_amount") @db.Decimal(8, 2)
  servingSizeUnit   String   @map("serving_size_unit") @db.VarChar(50)
  calories          Int
  protein           Decimal  @db.Decimal(6, 2)
  carbohydrates     Decimal  @db.Decimal(6, 2)
  fat               Decimal  @db.Decimal(6, 2)
  fiber             Decimal  @default(0) @db.Decimal(6, 2)
  sugar             Decimal  @default(0) @db.Decimal(6, 2)
  sodiumMg          Decimal  @default(0) @map("sodium_mg") @db.Decimal(8, 2)
  microsJson        Json     @default("{}") @map("micros_json")
  createdById       String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  mealEntries MealEntry[]

  @@map("food_items")
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model DailyLog {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  logDate  DateTime @map("log_date") @db.Date
  waterMl  Int      @default(0) @map("water_ml")
  notes    String?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries MealEntry[]

  @@unique([userId, logDate])
  @@map("daily_logs")
}

/**
 * No está en el DDL de §4, pero §3.3 define el suavizado EMA del peso y eso
 * necesita una serie donde guardarlo. Una medición por usuario y día.
 */
model WeightEntry {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  loggedOn DateTime @map("logged_on") @db.Date
  weightKg Decimal  @map("weight_kg") @db.Decimal(5, 2)
  /// EMA con alpha 0.10: el peso real oscila varios cientos de gramos por día
  /// por agua y digestión, y la tendencia es lo que hay que mirar.
  emaKg    Decimal  @map("ema_kg") @db.Decimal(6, 3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, loggedOn])
  @@index([userId, loggedOn(sort: Desc)])
  @@map("weight_entries")
}

model MealEntry {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyLogId       String   @map("daily_log_id") @db.Uuid
  mealType         MealType @map("meal_type")
  foodItemId       String   @map("food_item_id") @db.Uuid
  servingsConsumed Decimal  @map("servings_consumed") @db.Decimal(6, 2)
  loggedAt         DateTime @default(now()) @map("logged_at") @db.Timestamptz(6)

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id])

  @@index([dailyLogId])
  @@map("meal_entries")
}
