generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Espeja el DDL de §4 del blueprint. Los CHECK de gender/unit_preference se
// modelan como enums nativos de Postgres (equivalente y tipado en el cliente).
enum Gender {
  male
  female
  other
}

enum UnitPreference {
  metric
  imperial
}

enum RecipeKind {
  recipe
  meal
}

/**
 * Pedido de recuperación de contraseña.
 *
 * Se guarda el sha256 del token, nunca el token: si alguien lee esta tabla no
 * puede entrar a ninguna cuenta. Un solo uso y vence en una hora.
 */
model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

enum FoodSource {
  user
  openfoodfacts
  curated
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String?        @unique @db.VarChar(255)
  passwordHash   String?        @map("password_hash") @db.VarChar(255)
  isGuest        Boolean        @default(false) @map("is_guest")
  firstName      String         @map("first_name") @db.VarChar(100)
  dob            DateTime       @db.Date
  gender         Gender
  heightCm       Decimal        @map("height_cm") @db.Decimal(5, 2)
  /// Opcional: con este dato el BMR sale por Katch-McArdle en vez de
  /// Mifflin-St Jeor. Se guarda porque el objetivo se recalcula cada vez que
  /// el usuario se pesa; sin persistirlo, el primer recálculo cambiaría de
  /// fórmula y le movería las calorías sin que nadie tocara nada.
  bodyFatPct     Decimal?       @map("body_fat_pct") @db.Decimal(4, 1)
  activityLevel  Decimal        @default(1.200) @map("activity_level") @db.Decimal(4, 3)
  unitPreference UnitPreference @default(metric) @map("unit_preference")
  /// Los 2 litros de default no salen de ninguna guía seria: es el número que
  /// la gente espera ver. Se puede cambiar porque el que entrena en verano
  /// necesita bastante más.
  waterGoalMl    Int            @default(2000) @map("water_goal_ml")
  /// Sube con cada cambio de contraseña y viaja dentro del token. Sin esto,
  /// resetear la contraseña no echaría al que te robó la cuenta: su token
  /// seguiría sirviendo hasta vencer, que son días.
  tokenVersion   Int            @default(0) @map("token_version")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  goals          UserGoal[]
  createdFoods   FoodItem[]
  dailyLogs      DailyLog[]
  weights        WeightEntry[]
  recipes        Recipe[]
  passwordResets PasswordReset[]
  favorites      FoodFavorite[]
  routines       Routine[]

  @@map("users")
}

model UserGoal {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  targetWeightKg Decimal  @map("target_weight_kg") @db.Decimal(5, 2)
  weeklyChangeKg Decimal  @map("weekly_change_kg") @db.Decimal(3, 2)
  dailyCalories  Int      @map("daily_calories")
  proteinGrams   Int      @map("protein_grams")
  carbsGrams     Int      @map("carbs_grams")
  fatGrams       Int      @map("fat_grams")
  effectiveFrom  DateTime @default(now()) @map("effective_from") @db.Date
  isActive       Boolean  @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_goals")
}

model FoodItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barcode           String?  @unique @db.VarChar(50)
  name              String   @db.VarChar(255)
  brand             String?  @db.VarChar(255)
  verified          Boolean  @default(false)
  /// Procedencia y confianza son preguntas distintas y verified sola no las
  /// sostiene: sirve para distinguir en la UI un alimento que cargó el usuario
  /// de uno importado, y para desempatar la búsqueda si el catálogo importado
  /// termina tapando al curado.
  source            FoodSource @default(user)
  servingSizeAmount Decimal  @map("serving_size_amount") @db.Decimal(8, 2)
  servingSizeUnit   String   @map("serving_size_unit") @db.VarChar(50)
  calories          Int
  protein           Decimal  @db.Decimal(6, 2)
  carbohydrates     Decimal  @db.Decimal(6, 2)
  fat               Decimal  @db.Decimal(6, 2)
  fiber             Decimal  @default(0) @db.Decimal(6, 2)
  sugar             Decimal  @default(0) @db.Decimal(6, 2)
  sodiumMg          Decimal  @default(0) @map("sodium_mg") @db.Decimal(8, 2)
  microsJson        Json     @default("{}") @map("micros_json")
  createdById       String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  mealEntries      MealEntry[]
  recipeComponents RecipeComponent[]
  favorites        FoodFavorite[]

  @@map("food_items")
}

/**
 * Alimento marcado por el usuario.
 *
 * Los recientes ya resuelven "lo que como siempre", pero se ensucian con
 * cualquier cosa que se registre una vez. Un favorito es explícito y no se cae
 * de la lista.
 */
model FoodFavorite {
  userId     String   @map("user_id") @db.Uuid
  foodItemId String   @map("food_item_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@id([userId, foodItemId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("food_favorites")
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model DailyLog {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  logDate  DateTime @map("log_date") @db.Date
  waterMl  Int      @default(0) @map("water_ml")
  notes    String?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   MealEntry[]
  exercises ExerciseEntry[]
  strength  StrengthEntry[]

  @@unique([userId, logDate])
  @@map("daily_logs")
}

/**
 * Actividad del día. La otra mitad de la ecuación: el objetivo diario sube por
 * lo que se quema, no solo baja por lo que se come.
 *
 * El nombre se copia acá y no se referencia un catálogo: las actividades son
 * una tabla estática en el código (src/exercise/catalog.ts) y guardar el texto
 * deja el historial intacto si mañana se renombra o se saca una actividad.
 * caloriesBurned queda persistida por la misma razón: se calculó con el peso
 * de ese día y volver a pesarse no puede reescribir el pasado.
 */
model ExerciseEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyLogId     String   @map("daily_log_id") @db.Uuid
  name           String   @db.VarChar(100)
  durationMin    Int      @map("duration_min")
  caloriesBurned Int      @map("calories_burned")
  loggedAt       DateTime @default(now()) @map("logged_at") @db.Timestamptz(6)

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@index([dailyLogId])
  @@map("exercise_entries")
}

/**
 * Series de gimnasio. Va aparte de ExerciseEntry porque no comparte nada con
 * ella: acá no hay minutos ni MET, y por lo tanto tampoco calorías quemadas.
 * El dataset de movimientos no trae MET y estimarlo sería inventarlo, así que
 * la fuerza no toca el margen del día: es historial de cargas.
 *
 * El nombre se copia igual que en ExerciseEntry, por el mismo motivo.
 * weightKg es opcional: dominadas y flexiones se hacen sin peso agregado.
 */
model StrengthEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyLogId String   @map("daily_log_id") @db.Uuid
  name       String   @db.VarChar(120)
  sets       Int
  reps       Int
  weightKg   Decimal? @map("weight_kg") @db.Decimal(5, 1)
  /// Esfuerzo percibido, escala RPE de 1 a 10 en pasos de 0.5: 10 es no poder
  /// hacer una repetición más, 8 es dejarse dos. Es el dato que explica por qué
  /// un mismo peso rindió distinto entre dos semanas, y lo único de acá que la
  /// balanza no puede medir. Opcional: quien no lo usa no tiene que inventarlo.
  rpe        Decimal? @db.Decimal(3, 1)
  /// Una fila cargada desde una rutina nace pendiente: sus números son el
  /// objetivo del entreno, no lo que se hizo. Al confirmarla se corrigen los
  /// que hayan cambiado y pasa a hecha. Lo que se carga a mano nace hecho.
  /// El volumen del día solo cuenta lo hecho.
  done       Boolean  @default(true)
  loggedAt   DateTime @default(now()) @map("logged_at") @db.Timestamptz(6)

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@index([dailyLogId])
  @@map("strength_entries")
}

/**
 * Una rutina: la lista de movimientos de un entreno con sus objetivos.
 *
 * Es la plantilla, no el registro. Cargarla en un día copia sus ítems a
 * strength_entries y desde ahí viven aparte: editar la rutina después no
 * reescribe lo que ya se entrenó, igual que con las recetas.
 */
model Routine {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(120)
  notes     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items RoutineItem[]

  @@unique([userId, name])
  @@map("routines")
}

model RoutineItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routineId String   @map("routine_id") @db.Uuid
  name      String   @db.VarChar(120)
  sets      Int
  reps      Int
  weightKg  Decimal? @map("weight_kg") @db.Decimal(5, 1)
  /// El esfuerzo al que se apunta en ese movimiento. Ver StrengthEntry.rpe.
  rpe       Decimal? @db.Decimal(3, 1)
  position  Int

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@map("routine_items")
}

/**
 * No está en el DDL de §4, pero §3.3 define el suavizado EMA del peso y eso
 * necesita una serie donde guardarlo. Una medición por usuario y día.
 */
model WeightEntry {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  loggedOn DateTime @map("logged_on") @db.Date
  weightKg Decimal  @map("weight_kg") @db.Decimal(5, 2)
  /// EMA con alpha 0.10: el peso real oscila varios cientos de gramos por día
  /// por agua y digestión, y la tendencia es lo que hay que mirar.
  emaKg    Decimal  @map("ema_kg") @db.Decimal(6, 3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, loggedOn])
  @@index([userId, loggedOn(sort: Desc)])
  @@map("weight_entries")
}

/**
 * Receta: colección con nombre de (alimento, cantidad) que rinde N porciones.
 *
 * No se borra nunca, se archiva. Hay meal_entries históricas que la referencian
 * y el historial no se reescribe, igual que user_goals se desactiva en vez de
 * borrarse.
 */
model Recipe {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   @db.VarChar(255)
  /// Una comida guardada ("mi desayuno") es el mismo motor con totalServings 1:
  /// se registra entera y no se escala. El flag existe solo para separarlas en
  /// la interfaz y no preguntar porciones donde no aplica.
  kind          RecipeKind @default(recipe)
  /// En cuántas porciones rinde la receta entera. Loguear una porción de un
  /// guiso que rinde seis escala cada componente por 1/6.
  totalServings Decimal  @map("total_servings") @db.Decimal(6, 2)
  isArchived    Boolean  @default(false) @map("is_archived")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  components RecipeComponent[]
  entries    MealEntry[]

  @@index([userId, isArchived])
  @@map("recipes")
}

/**
 * quantity va en PORCIONES del alimento, no en gramos: misma unidad que
 * meal_entries.servings_consumed. Así el alta de un componente reusa el mismo
 * buscador y el mismo input que el alta de una comida, y expandir la receta al
 * loguearla es una multiplicación sin conversión de unidades.
 */
model RecipeComponent {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId   String  @map("recipe_id") @db.Uuid
  foodItemId String  @map("food_item_id") @db.Uuid
  quantity   Decimal @db.Decimal(6, 2)
  /// Orden estable de la lista; sin esto depende del plan del planner.
  position   Int     @default(0)

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id])

  @@index([recipeId])
  @@map("recipe_components")
}

model MealEntry {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyLogId       String   @map("daily_log_id") @db.Uuid
  mealType         MealType @map("meal_type")
  /// Nullable desde el quick add: unas calorías sueltas no tienen alimento
  /// detrás. Un CHECK en la base garantiza que hay food_item_id O los campos
  /// quick_*, nunca ninguno ni los dos.
  foodItemId       String?  @map("food_item_id") @db.Uuid
  servingsConsumed Decimal  @map("servings_consumed") @db.Decimal(6, 2)
  loggedAt         DateTime @default(now()) @map("logged_at") @db.Timestamptz(6)

  quickName     String?  @map("quick_name") @db.VarChar(100)
  quickCalories Int?     @map("quick_calories")
  quickProtein  Decimal? @map("quick_protein") @db.Decimal(6, 2)
  quickCarbs    Decimal? @map("quick_carbs") @db.Decimal(6, 2)
  quickFat      Decimal? @map("quick_fat") @db.Decimal(6, 2)

  /// Qué receta generó esta fila. Solo para mostrar el nombre y ofrecer volver
  /// a loguearla: los números NO se releen de acá.
  recipeId       String?  @map("recipe_id") @db.Uuid
  /// Un uuid por EVENTO de logueo, que agrupa las N filas expandidas para
  /// poder colapsarlas en una línea, editarlas y borrarlas como una unidad.
  /// No alcanza con recipeId porque la misma receta puede loguearse dos veces
  /// el mismo día.
  recipeGroupId  String?  @map("recipe_group_id") @db.Uuid
  /// Porciones de receta que representa el grupo, repetido en cada fila.
  /// Desnormalizado a propósito: reescalar es servings * (nuevo / este valor)
  /// fila por fila, sin volver a mirar la receta, que puede haber cambiado
  /// desde que se logueó.
  recipeServings Decimal? @map("recipe_servings") @db.Decimal(6, 2)

  dailyLog DailyLog  @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  /// Restrict explícito: en una relación opcional Prisma pondría SetNull, y eso
  /// dejaría una fila con food_item_id en null y sin campos quick_*, que es
  /// exactamente lo que el CHECK meal_entries_food_or_quick_chk prohíbe. Un
  /// alimento con historial detrás no se borra.
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
  recipe   Recipe?   @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([dailyLogId])
  @@index([recipeGroupId])
  @@map("meal_entries")
}
