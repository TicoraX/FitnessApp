# Copiar a .env y completar. Nunca commitear .env.
DATABASE_URL=postgresql://fittrack:fittrack@localhost:5433/fittrack?schema=public
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=3100

# Solo para correr la suite end to end repetidas veces en local.
# En produccion se deja sin definir: el limite es 5 por 15 minutos.
AUTH_RATE_LIMIT=5

# Igual que el anterior: 3 por 15 minutos en produccion, mas alto solo para
# poder correr la sonda repetidas veces.
FORGOT_RATE_LIMIT=3

# Techo global de la API. 100 por minuto en produccion; las suites lo pasan
# porque comparten IP con el limiter.
API_RATE_LIMIT=100

# Base del link de recuperacion de contrasena.
APP_URL=http://localhost:5177

# console imprime el mail en el log y no necesita nada mas: es lo que se usa
# en desarrollo. Con resend, RESEND_API_KEY pasa a ser obligatoria y la app no
# arranca sin ella.
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=FitTrack <no-reply@fittrack.app>
